{
  "name": "tagstudio-web-workspace",
  "private": true,
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan.bold,magenta.bold \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "uv run tagstudio-api --host 127.0.0.1 --port 5987",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "lint": "bun run --cwd apps/web lint",
    "test:web": "bun run --cwd apps/web test",
    "generate:openapi": "uv run tagstudio-api-openapi --output packages/api-client/openapi/tagstudio-api.json"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
